# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your keys.
# If keys are omitted, the workflow automatically utilizes its deterministic
# heuristic engine, guaranteeing 100% test reproducibility without external cost.

# OpenAI API Key (Required only for live frontier model calls)
OPENAI_API_KEY=your_openai_api_key_here

# Model Identifier (Defaults to gpt-4o or responses-compatible model)
OPENAI_MODEL=gpt-4o

# Telegram Operator Notification Webhook / Bot Token (Optional)
# Format: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Webhook URL (Optional fallback for operator cards)
SLACK_WEBHOOK_URL=

# Execution Mode: "live" (API required) or "auto" (fallback if no key present)
EXECUTION_MODE=auto

# Minimum Confidence Threshold for Tier 1 Enterprise Routing (0 - 100)
ENTERPRISE_THRESHOLD=75
